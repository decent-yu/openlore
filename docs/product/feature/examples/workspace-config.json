{
  "example_only": true,
  "workspace": {
    "timezone": "Asia/Shanghai",
    "default_repository_connection_id": "repo-team",
    "default_ai_profile_id": "ai-codex",
    "ai_concurrency": 1
  },
  "repository_connections": [
    {
      "id": "repo-team",
      "name": "团队知识库",
      "repository": "example/team-knowledge",
      "branch": null,
      "credential_ref": "github-team-token",
      "state": "unverified"
    }
  ],
  "notification_connections": [
    {
      "id": "notify-tech",
      "name": "技术群",
      "protocol": "generic_json",
      "url_secret_ref": "webhook-tech",
      "state": "unverified"
    }
  ],
  "ai_profiles": [
    {
      "id": "ai-codex",
      "provider": "codex_cli",
      "executable": "/absolute/path/to/codex",
      "model": null,
      "state": "unverified"
    },
    {
      "id": "ai-gemini",
      "provider": "gemini_cli",
      "executable": "/absolute/path/to/gemini",
      "model": null,
      "state": "unverified"
    }
  ],
  "sources": [
    {
      "id": "cloudflare",
      "name": "Cloudflare Blog",
      "homepage": "https://blog.cloudflare.com/",
      "description": "网络、安全、基础设施与 Agent 工程实践",
      "capability_id": "web_feed",
      "target": {
        "url": "https://blog.cloudflare.com/rss/"
      },
      "enabled": true,
      "poll_interval_minutes": 30
    },
    {
      "id": "simon-willison",
      "name": "Simon Willison",
      "homepage": "https://simonwillison.net/",
      "description": "LLM 工具、编程 Agent、实验与技术评论",
      "capability_id": "web_feed",
      "target": {
        "url": "https://simonwillison.net/atom/everything/"
      },
      "enabled": true,
      "poll_interval_minutes": 30
    }
  ],
  "groups": [
    {
      "id": "group-agent",
      "name": "Agent 相关知识",
      "state": "draft",
      "focus": "Agent 的工具调用、上下文管理、评估与可靠性",
      "preferences": [
        "实现细节",
        "代码",
        "实验数据",
        "技术取舍"
      ],
      "sources": [
        {
          "source_id": "simon-willison",
          "keywords": [
            "agent",
            "tool calling"
          ],
          "exclude_keywords": []
        },
        {
          "source_id": "cloudflare",
          "keywords": [
            "agents",
            "MCP",
            "Workers"
          ],
          "exclude_keywords": []
        }
      ],
      "filter": {
        "match_mode": "semantic",
        "min_relevance": 70,
        "min_quality": 50
      },
      "route": {
        "repository_connection_id": "repo-team",
        "base_path": "/docs/agent-leaning",
        "notification_connection_id": "notify-tech"
      },
      "ai_profile_id": "ai-codex",
      "schedule": {
        "mode": "daily",
        "at": "09:00"
      },
      "collection": {
        "initial_lookback_days": 7,
        "candidates_limit": 20,
        "selected_limit": 10
      },
      "research": {
        "mode": "linked_web",
        "max_new_pages": 6,
        "max_link_depth": 1,
        "max_ai_calls": 3,
        "timeout_seconds": 900,
        "primary_articles_per_task": 1,
        "question": "解释本篇文章的核心机制、论据、取舍与适用范围"
      },
      "outputs": {
        "digest_enabled": true,
        "research_enabled": true,
        "article_skill": "openlore-article-organizer",
        "research_skill": "openlore-article-research",
        "digest_skill": "openlore-batch-digest",
        "archive_images": true
      }
    },
    {
      "id": "group-performance",
      "name": "后端性能优化",
      "state": "draft",
      "focus": "数据库、延迟与吞吐的工程优化",
      "preferences": [
        "实验数据",
        "技术取舍"
      ],
      "sources": [
        {
          "source_id": "cloudflare",
          "keywords": [
            "database",
            "latency",
            "performance"
          ],
          "exclude_keywords": []
        }
      ],
      "filter": {
        "match_mode": "any",
        "min_relevance": 70,
        "min_quality": 50
      },
      "route": {
        "repository_connection_id": "repo-team",
        "base_path": "/docs/backend-performance",
        "notification_connection_id": null
      },
      "ai_profile_id": "ai-codex",
      "schedule": {
        "mode": "daily",
        "at": "09:00"
      },
      "collection": {
        "initial_lookback_days": 7,
        "candidates_limit": 20,
        "selected_limit": 10
      },
      "research": {
        "mode": "local",
        "max_new_pages": 0,
        "max_ai_calls": 3,
        "timeout_seconds": 900,
        "primary_articles_per_task": 1,
        "question": "解释本篇文章的核心机制、论据、取舍与适用范围"
      },
      "outputs": {
        "digest_enabled": false,
        "research_enabled": false,
        "article_skill": "openlore-article-organizer",
        "research_skill": "openlore-article-research",
        "digest_skill": "openlore-batch-digest",
        "archive_images": true
      }
    }
  ]
}
